# Copy to .env and adjust. deploy.sh creates .env from this file if it's missing.

# Where the admin UI is published on the host. Use 127.0.0.1 when a TLS
# reverse proxy (nginx, Caddy, Traefik) runs on the same machine — strongly
# recommended, the UI handles VPN keys and 2FA secrets.
TUNNELKEY_BIND=0.0.0.0
TUNNELKEY_PORT=9897

# First admin account. Created only on the first start (empty database);
# password at least 12 characters. You can clear these afterwards.
TUNNELKEY_ADMIN_USER=
TUNNELKEY_ADMIN_PASSWORD=
