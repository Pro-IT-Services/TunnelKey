<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
    <dict>
        <key>CFBundlePackageType</key>
        <string>APPL</string>
        <key>CFBundleName</key>
        <string>{{.Info.ProductName}}</string>
        <key>CFBundleDisplayName</key>
        <string>{{.Info.ProductName}}</string>
        <key>CFBundleExecutable</key>
        <string>{{.OutputFilename}}</string>
        <key>CFBundleIdentifier</key>
        <string>com.proitservices.tunnelkey</string>
        <key>CFBundleVersion</key>
        <string>{{.Info.ProductVersion}}</string>
        <key>CFBundleGetInfoString</key>
        <string>{{.Info.Comments}}</string>
        <key>CFBundleShortVersionString</key>
        <string>{{.Info.ProductVersion}}</string>
        <key>CFBundleIconFile</key>
        <string>iconfile</string>
        <key>LSApplicationCategoryType</key>
        <string>public.app-category.utilities</string>
        <key>LSMinimumSystemVersion</key>
        <string>12.0.0</string>
        <key>NSHighResolutionCapable</key>
        <string>true</string>
        <key>NSHumanReadableCopyright</key>
        <string>{{.Info.Copyright}}</string>

        <!--
          Document types are declared here instead of through wails.json
          "fileAssociations" (do not add both: the keys would be duplicated).
          .tunnelkey: Tunnelkey is the owner. .ovpn: offered as an alternate
          viewer only, so it never takes over another OpenVPN client.
        -->
        <key>CFBundleDocumentTypes</key>
        <array>
            <dict>
                <key>CFBundleTypeName</key>
                <string>Tunnelkey setup file</string>
                <key>CFBundleTypeRole</key>
                <string>Viewer</string>
                <key>LSHandlerRank</key>
                <string>Owner</string>
                <key>LSItemContentTypes</key>
                <array>
                    <string>com.proitservices.tunnelkey.setup</string>
                </array>
                <key>CFBundleTypeIconFile</key>
                <string>iconfile</string>
            </dict>
            <dict>
                <key>CFBundleTypeName</key>
                <string>OpenVPN profile</string>
                <key>CFBundleTypeRole</key>
                <string>Viewer</string>
                <key>LSHandlerRank</key>
                <string>Alternate</string>
                <key>LSItemContentTypes</key>
                <array>
                    <string>net.openvpn.ovpn</string>
                </array>
            </dict>
        </array>

        <key>UTExportedTypeDeclarations</key>
        <array>
            <dict>
                <key>UTTypeIdentifier</key>
                <string>com.proitservices.tunnelkey.setup</string>
                <key>UTTypeDescription</key>
                <string>Tunnelkey setup file</string>
                <key>UTTypeConformsTo</key>
                <array>
                    <string>public.json</string>
                    <string>public.data</string>
                </array>
                <key>UTTypeIconFile</key>
                <string>iconfile</string>
                <key>UTTypeTagSpecification</key>
                <dict>
                    <key>public.filename-extension</key>
                    <array>
                        <string>tunnelkey</string>
                    </array>
                    <key>public.mime-type</key>
                    <array>
                        <string>application/vnd.tunnelkey.setup+json</string>
                    </array>
                </dict>
            </dict>
        </array>

        <!-- .ovpn is not ours: imported, so another app's declaration wins. -->
        <key>UTImportedTypeDeclarations</key>
        <array>
            <dict>
                <key>UTTypeIdentifier</key>
                <string>net.openvpn.ovpn</string>
                <key>UTTypeDescription</key>
                <string>OpenVPN profile</string>
                <key>UTTypeConformsTo</key>
                <array>
                    <string>public.plain-text</string>
                </array>
                <key>UTTypeTagSpecification</key>
                <dict>
                    <key>public.filename-extension</key>
                    <array>
                        <string>ovpn</string>
                    </array>
                    <key>public.mime-type</key>
                    <array>
                        <string>application/x-openvpn-profile</string>
                    </array>
                </dict>
            </dict>
        </array>

        {{if .Info.Protocols}}
        <key>CFBundleURLTypes</key>
        <array>
          {{range .Info.Protocols}}
            <dict>
                <key>CFBundleURLName</key>
                <string>com.proitservices.tunnelkey.{{.Scheme}}</string>
                <key>CFBundleURLSchemes</key>
                <array>
                    <string>{{.Scheme}}</string>
                </array>
                <key>CFBundleTypeRole</key>
                <string>{{.Role}}</string>
            </dict>
          {{end}}
        </array>
        {{end}}
    </dict>
</plist>
