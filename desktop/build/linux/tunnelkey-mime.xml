<?xml version="1.0" encoding="UTF-8"?>
<!-- Installed as /usr/share/mime/packages/tunnelkey.xml -->
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="application/vnd.tunnelkey.setup+json">
    <comment>Tunnelkey setup file</comment>
    <sub-class-of type="application/json"/>
    <icon name="tunnelkey"/>
    <glob pattern="*.tunnelkey" weight="80"/>
  </mime-type>
  <mime-type type="application/x-openvpn-profile">
    <comment>OpenVPN profile</comment>
    <sub-class-of type="text/plain"/>
    <glob pattern="*.ovpn"/>
  </mime-type>
</mime-info>
