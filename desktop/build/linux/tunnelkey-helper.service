[Unit]
Description=Tunnelkey helper (starts OpenVPN for the Tunnelkey app)
Documentation=https://github.com/Pro-IT-Services/TunnelKey
After=network.target
Wants=network.target

[Service]
Type=simple
ExecStart=/usr/lib/tunnelkey/tunnelkey-helper
Restart=on-failure
RestartSec=2s
# /run/tunnelkey: helper.sock (0666, any local user may connect) and the
# 0700 per-session directories with the management sockets.
RuntimeDirectory=tunnelkey
RuntimeDirectoryMode=0755
# openvpn runs as a child of the helper; stop them together.
KillMode=control-group
TimeoutStopSec=15s

# Hardening. openvpn needs to create tun devices, change routes/addresses
# (netlink), optionally use the ovpn-dco kernel module, drop privileges with
# --user/--group, and call resolvectl over D-Bus. Do not add PrivateNetwork,
# PrivateDevices, ProtectKernelModules or a strict ProtectSystem without
# ReadWritePaths=/run/tunnelkey.
NoNewPrivileges=yes
ProtectSystem=full
ProtectHome=read-only
PrivateTmp=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectKernelLogs=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE CAP_SETUID CAP_SETGID CAP_SETPCAP CAP_CHOWN CAP_FOWNER CAP_DAC_OVERRIDE CAP_DAC_READ_SEARCH CAP_KILL CAP_SYS_CHROOT CAP_AUDIT_WRITE
DeviceAllow=/dev/net/tun rw
DevicePolicy=closed
UMask=0077

[Install]
WantedBy=multi-user.target
